class  Car:
    def __init__(self, type):
        self.type = type

    def start(self):
        print(f"{self.type} car is starting.")

    def stop(self):
        print(f"{self.type} car is stopping.")

class toyota(Car):
    def __init__(self, type, name):
        super().__init__(type)
        self.name = name
        super().start()
        
car1 = toyota("SUV", "Toyota Fortuner")
print(car1.type)