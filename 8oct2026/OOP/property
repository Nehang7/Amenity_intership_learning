class student:
    def __init__(self, phy, chem, maths):
        self.phy = phy
        self.chem = chem
        self.maths = maths

    @property
    def percentage(self):
        return str((self.phy + self.chem + self.maths) / 3) + "%"

stu1 = student(80, 90, 70)
print("Percentage:", stu1.percentage)

stu1.phy = 85
print("Updated Percentage:", stu1.percentage)