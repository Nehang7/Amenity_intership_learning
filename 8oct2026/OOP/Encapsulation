class account:
    def __init__(self, bal,acc):
        self.balance=bal
        self.account_no=acc

    def debit(self, amount):
        self.balance -= amount
        print("Rs.", amount, "debited")
        print("Remaining balance:", self.get_balance)

    def credit(self, amount):
        self.balance += amount
        print("Rs.", amount, "credited")
        print("Remaining balance:", self.get_balance)

    def get_balance(self):
        return self.balance

acc1= account(1000, 12345)
print("Account number:", acc1.account_no)
print( "Balance:", acc1.balance)